@startuml
hide circle
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam entity {
    BackgroundColor LightCyan
    BorderColor DarkCyan
}

entity "**User**" as user {
  * id_user : int <<PK>>
  --
  nama : varchar(50)
  username : varchar(20) <<UQ>>
  password : varchar(255)
}

entity "**Pelanggan**" as pelanggan {
  * id_pelanggan : int <<PK>>
  --
  nama_pelanggan : varchar(100)
  no_telp : varchar(15)
  alamat : text
}

entity "**Produk**" as produk {
  * id_produk : int <<PK>>
  --
  nama_produk : varchar(100)
  kategori : enum
  harga_awal : int
  harga_jual : int
  nama_jagal : varchar(100)
}

entity "**Pesanan**" as pesanan {
  * id_pesanan : varchar(20) <<PK>>
  --
  id_pelanggan : int <<FK>>
  id_user : int <<FK>>
  tgl_order : date
  metode_bayar : enum
  status_bayar : enum
  total_pembayaran : int
  tgl_antar : date
}

entity "**Piutang**" as piutang {
  * id_piutang : int <<PK>>
  --
  id_pesanan : varchar(20) <<FK>> <<UQ>>
  tgl_jatuh_tempo : date
  total_tagihan : decimal(15,2)
  jumlah_terbayar : decimal(15,2)
  status_piutang : enum
}

entity "**Pengeluaran_Harian**" as pengeluaran {
  * id_pengeluaran : int <<PK>>
  --
  id_user : int <<FK>>
  tgl_pengeluaran : date
  kategori_pengeluaran : enum
  nominal : int
  keterangan : text
}

' Tabel ini hanya muncul sebagai hasil implementasi fisik dari relasi M:N
entity "**Tabel Hasil Relasi:\nPesanan_Detail**" as pesanan_detail #FFF3CD {
  * id_detail : int <<PK>>
  --
  id_pesanan : varchar(20) <<FK>>
  id_produk : int <<FK>>
  qty : decimal(3,2)
  harga_jual_saat_ini : int
  subtotal : int
}

' --- KARDINALITAS ENTITAS UTAMA ---

user ||--o{ pesanan : "Mencatat\n(1:N)"
user ||--o{ pengeluaran : "Mencatat\n(1:N)"
pelanggan ||--o{ pesanan : "Melakukan\n(1:N)"

pesanan ||--|| piutang : "Memiliki\n(1:1)"

' --- RELASI MANY TO MANY (SESUAI KONSEP) ---
pesanan }o--o{ produk : "Memuat\n(M:N)"

' Garis putus-putus menunjukkan atribut ini menempel pada relasi M:N di atasnya
pesanan_detail .up. pesanan : "<<Tabel Hasil>>"
pesanan_detail .up. produk : "<<Tabel Hasil>>"

@enduml