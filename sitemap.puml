@startuml
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam rectangle {
    RoundCorner 10
    Shadowing false
}

' --- LEVEL 1: ROOT (PINK) ---
rectangle "<color:white>**[Web Mobile View]**\n<color:white>Olivia Meat N Fresh" as root #D84374

