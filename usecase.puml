@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor LightCyan
    BorderColor DarkCyan
}

actor "Owner (Pemilik)" as owner

rectangle "Sistem Informasi Akuntansi & Monitoring Piutang\nBerbasis Web Mobile View" {
    
    '--- Akses ---
    usecase "Melakukan Login" as UC_Login
    usecase "Melakukan Logout" as UC_Logout
    usecase "Mengelola Profil Akun" as UC_Profil
    
    '--- Dashboard Utama ---
    usecase "Melihat Dashboard Utama\n(Ringkasan Keuangan & Notifikasi)" as UC_Dashboard
    
    '--- Core Fitur Master ---
    usecase "Mengelola Data Produk Daging" as UC_Produk
    usecase "Mengelola Data Pelanggan" as UC_Pelangan
    
    '--- Transaksi & Operasional (Input Data) ---
    usecase "Mencatat Pesanan Baru" as UC_Pesanan
    usecase "Mencatat Metode Pembayaran\n(Tunai / Transfer / Tempo)" as UC_Bayar
    usecase "Mencatat Pengeluaran Harian" as UC_Pengeluaran
    
    '--- Monitoring & Akuntansi (Output Data) ---
    usecase "Monitoring Piutang Pelanggan\n(Status Tempo)" as UC_Piutang
    usecase "Melihat Laporan Laba/Rugi" as UC_LabaRugi
}

'--- Hubungan Owner ke Fitur (Tanpa direct line ke Login) ---
owner --> UC_Logout
owner --> UC_Dashboard
owner --> UC_Pesanan
owner --> UC_Pengeluaran
owner --> UC_Piutang
owner --> UC_LabaRugi
owner --> UC_Produk
owner --> UC_Pelangan
owner --> UC_Profil

'--- Include Core Logic ---
UC_Pesanan ..> UC_Bayar : <<include>>

'--- Include ke Login (Aturan Kampus) ---
UC_Dashboard ..> UC_Login : <<include>>
UC_Profil ..> UC_Login : <<include>>
UC_Produk ..> UC_Login : <<include>>
UC_Pelangan ..> UC_Login : <<include>>
UC_Pesanan ..> UC_Login : <<include>>
UC_Pengeluaran ..> UC_Login : <<include>>
UC_Piutang ..> UC_Login : <<include>>
UC_LabaRugi ..> UC_Login : <<include>>
UC_Logout ..> UC_Login : <<include>>

@enduml