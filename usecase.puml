@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Owner (Pemilik)" as owner

rectangle "Sistem Informasi Akuntansi, Retur Barang,\ndan Monitoring Piutang Berbasis Web Mobile View" {
    
    '--- Modul Akses ---
    usecase "Melakukan Login & Logout" as UC_Login
    
    '--- Modul Akuntansi & Transaksi ---
    usecase "Mencatat Transaksi Penjualan" as UC_Penjualan
    usecase "Mencatat Metode Pembayaran\n(Tunai / Transfer / Tempo)" as UC_Bayar
    usecase "Melihat Laporan Laba/Rugi Harian" as UC_LabaRugi
    
    '--- Modul Monitoring Piutang ---
    usecase "Melihat Daftar Piutang Pelanggan\n(Status Tempo)" as UC_Piutang
    usecase "Memantau Hari Jatuh Tempo" as UC_NotifTempo
    usecase "Memperbarui Status Pelunasan Piutang\n(Tandai Lunas)" as UC_StatusPiutang
    
    '--- Modul Retur Barang ---
    usecase "Menginput Data Retur Barang" as UC_InputRetur
    usecase "Mengunggah Foto Bukti Fisik Daging" as UC_FotoRetur
    usecase "Melihat Riwayat Retur" as UC_RiwayatRetur
}

'--- Hubungan Aktor ---
owner --> UC_Login
owner --> UC_Penjualan
owner --> UC_LabaRugi
owner --> UC_Piutang
owner --> UC_NotifTempo
owner --> UC_StatusPiutang
owner --> UC_InputRetur
owner --> UC_RiwayatRetur

'--- Relasi Include ---
UC_Penjualan ..> UC_Bayar : <<include>>
UC_InputRetur ..> UC_FotoRetur : <<include>>

@enduml